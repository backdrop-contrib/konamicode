<?php
/**
 * @file
 * The Konami Code Backdrop module
 */

/**
 * Implements hook_config_info().
 */
function konamicode_config_info() {
  return [
    'konamicode.settings' => [
      'label' => t('Konami Code settings'),
      'group' => t('System'),
    ],
  ];
}

/**
 * Implements hook_init().
 */
function konamicode_init() {
  $config = config('konamicode.settings');

  // Check if the Konami Code module is enabled.
  if (!$config->get('konamicode_enabled')) {
    return; // Exit early if the module is not enabled.
  }

  $settings = [];

  // Define all actions and their respective flat configuration keys.
  $actions = [
    'imageSpawn' => [
      'enabled' => 'konamicode_imageSpawn_enabled',
      'keycode' => 'konamicode_imageSpawn_keycode_sequence',
      'images' => 'konamicode_imageSpawn_images',
      'max' => 'konamicode_imageSpawnmax',
    ],
    'redirect' => [
      'enabled' => 'konamicode_redirect_enabled',
      'keycode' => 'konamicode_redirect_keycode_sequence',
      'destination' => 'konamicode_redirect_destination',
    ],
    'alert' => [
      'enabled' => 'konamicode_alert_enabled',
      'keycode' => 'konamicode_alert_keycode_sequence',
      'message' => 'konamicode_alert_message',
    ],
    'fliptext' => [
      'enabled' => 'konamicode_fliptext_enabled',
      'keycode' => 'konamicode_fliptext_keycode_sequence',
    ],
    'cornify' => [
      'enabled' => 'konamicode_cornify_enabled',
      'keycode' => 'konamicode_cornify_keycode_sequence',
      'message' => 'konamicode_cornify_message',
    ],
    'geocitiesizer' => [
      'enabled' => 'konamicode_geocitiesizer_enabled',
      'keycode' => 'konamicode_geocitiesizer_keycode_sequence',
      'theme' => 'konamicode_geocitiesizer_theme',
    ],
    'asteroids' => [
      'enabled' => 'konamicode_asteroids_enabled',
      'keycode' => 'konamicode_asteroids_keycode_sequence',
      'message' => 'konamicode_asteroids_message',
    ],
    'replaceImages' => [
      'enabled' => 'konamicode_replaceImages_enabled',
      'keycode' => 'konamicode_replaceImages_keycode_sequence',
      'integrations' => 'konamicode_replaceImages_integrations'
    ],
    'raptorize' => [
      'enabled' => 'konamicode_raptorize_enabled',
      'keycode' => 'konamicode_raptorize_keycode_sequence',
    ],
    'katamari' => [
      'enabled' => 'konamicode_katamari_enabled',
      'keycode' => 'konamicode_katamari_keycode_sequence',
    ],
    'snowfall' => [
      'enabled' => 'konamicode_snowfall_enabled',
      'keycode' => 'konamicode_snowfall_keycode_sequence',
      'flake_count' => 'konamicode_snowfall_flake_count',
      'flake_color' => 'konamicode_snowfall_flake_color',
      'min_size' => 'konamicode_snowfall_minsize',
      'max_size' => 'konamicode_snowfall_maxsize',
      'min_speed' => 'konamicode_snowfall_minspeed',
      'max_speed' => 'konamicode_snowfall_maxspeed',
      'round' => 'konamicode_snowfall_round',
      'shadow' => 'konamicode_snowfall_shadow',
    ],
    'gg' => [
      'enabled' => 'konamicode_gg_enabled',
      'keycode' => 'konamicode_gg_keycode_sequence',
    ],
    'browserponies' => [
      'enabled' => 'konamicode_browserponies_enabled',
      'keycode' => 'konamicode_browserponies_keycode_sequence',
      'baseurl' => 'konamicode_browserponies_baseurl',
      'fade_duration' => 'konamicode_browserponies_fadeDuration',
      'volume' => 'konamicode_browserponies_volume',
      'fps' => 'konamicode_browserponies_fps',
      'speed' => 'konamicode_browserponies_speed',
      'audio_enabled' => 'konamicode_browserponies_audioEnabled',
      'show_fps' => 'konamicode_browserponies_showFps',
      'show_load_progress' => 'konamicode_browserponies_showLoadProgress',
      'speak_probability' => 'konamicode_browserponies_speakProbability',
      'applejack' => 'konamicode_browserponies_applejack',
      'fluttershy' => 'konamicode_browserponies_fluttershy',
      'pinkiepie' => 'konamicode_browserponies_pinkiepie',
      'rainbowdash' => 'konamicode_browserponies_rainbowdash',
      'rarity' => 'konamicode_browserponies_rarity',
      'twilightsparkle' => 'konamicode_browserponies_twilightsparkle',
    ],
  ];

  if ($config->get('konamicode_fliptext_enabled')) {
    backdrop_add_js(backdrop_get_path('module', 'konamicode') . '/konamicode-fliptext.js');
  }

  if ($config->get('konamicode_raptorize_enabled')) {
    $settings['konamicodeR'] = backdrop_get_path('module', 'konamicode');
  }

  if ($config->get('konamicode_snowfall_enabled')) {
    $settings['snowfall'] = backdrop_get_path('module', 'konamicode');
  }

  if ($config->get('konamicode_gg_enabled')) {
    $settings['gg'] = backdrop_get_path('module', 'konamicode');
  }

  // Loop through actions and prepare JavaScript settings.
  foreach ($actions as $action => $keys) {
    if (!empty($config->get($keys['enabled']))) {
      $action_settings = [];

      // Add keycode sequence.
      if (!empty($keys['keycode'])) {
        $action_settings['keycode'] = explode(',', $config->get($keys['keycode']));
      }

      // Add other settings for the action.
      foreach ($keys as $key => $config_key) {
        if ($key !== 'enabled' && $key !== 'keycode') {
          $value = $config->get($config_key);
          if ($value !== NULL) {
            $action_settings[$key] = is_numeric($value) ? (float) $value : $value;
          }
        }
      }

      $settings['konamicode'][$action] = $action_settings;
    }
  }

  // Pass settings to JavaScript.
  if (!empty($settings)) {
    backdrop_add_js($settings, ['type' => 'setting', 'scope' => JS_DEFAULT]);
  }

  // Add the main Konami Code plugin JavaScript.
  backdrop_add_js(backdrop_get_path('module', 'konamicode') . '/konamicode.js');
}

/**
 * Implements hook_permission().
 */
function konamicode_permission() {
  return [
    'administer konamicode' => [
      'title' => t('Administer Konami Code'),
      'description' => t('Configure Konami Code actions and effects.'),
    ],
  ];
}

/**
 * Implements hook_menu().
 */
function konamicode_menu() {
  $items = [];

  $items['admin/config/user-interface/konamicode'] = [
    'title' => 'Konami Code Settings',
    'description' => 'Manage settings for the Konami Code module.',
    'page callback' => 'drupal_get_form',
    'page arguments' => ['konamicode_admin_settings'],
    'access callback' => 'user_access',
    'access arguments' => ['administer site configuration'],
    'file' => 'konamicode.admin.inc', // Ensure the file is included.
  ];

  return $items;
}


/**
 * Implements hook_konamicode_GG().
 */
function konamicode_konamicode_gg() {
  $settings = array(
    'gg' => backdrop_get_path('module', 'konamicode'),
  );
  backdrop_add_js($settings, array('type' => 'setting', 'scope' => JS_DEFAULT));
}

